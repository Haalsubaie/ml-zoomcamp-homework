
import pandas as pd
import numpy as np

from sklearn.model_selection import train_test_split, KFold
from sklearn.metrics import roc_auc_score, f1_score, precision_score, recall_score
from sklearn.feature_extraction import DictVectorizer
from sklearn.linear_model import LogisticRegression


df = pd.read_csv(
    r"C:\Users\ha-al\Downloads\VScode\machine-learning-zoomcamp\cohorts\2026\data\course_lead_scoring_2026.csv"
)

categorical = df.select_dtypes(include=["object", "str"]).columns
numerical = df.select_dtypes(include=["number"]).columns

df[categorical] = df[categorical].fillna("NA")
df[numerical] = df[numerical].fillna(0.0)


df_full_train, df_test = train_test_split(
    df, test_size=0.2, random_state=1
)

df_train, df_val = train_test_split(
    df_full_train, test_size=0.25, random_state=1
)


y_train = df_train["converted"]

features = [
    "lead_score",
    "number_of_courses_viewed",
    "interaction_count",
    "annual_income"
]

for feature in features:
    auc = roc_auc_score(y_train, df_train[feature])

    if auc < 0.5:
        auc = roc_auc_score(y_train, -df_train[feature])

    print(f"{feature}: {auc:.3f}")


y_train = df_train["converted"].values
y_val = df_val["converted"].values

train_dicts = df_train.drop(
    columns=["converted"]
).to_dict(orient="records")

val_dicts = df_val.drop(
    columns=["converted"]
).to_dict(orient="records")

dv = DictVectorizer(sparse=True)

X_train = dv.fit_transform(train_dicts).astype(np.float64)
X_val = dv.transform(val_dicts).astype(np.float64)

X_train.indices = X_train.indices.astype(np.int32)
X_train.indptr = X_train.indptr.astype(np.int32)
X_val.indices = X_val.indices.astype(np.int32)
X_val.indptr = X_val.indptr.astype(np.int32)

model = LogisticRegression(
    solver="liblinear",
    C=1.0,
    max_iter=1000
)

model.fit(X_train, y_train)
y_pred = model.predict_proba(X_val)[:, 1]

auc = roc_auc_score(y_val, y_pred)
print(f"Validation AUC: {auc:.3f}")


thresholds = np.arange(0.0, 1.01, 0.01)

for threshold in thresholds:
    y_pred_binary = (y_pred >= threshold).astype(int)

    precision = precision_score(
        y_val, y_pred_binary, zero_division=0
    )
    recall = recall_score(
        y_val, y_pred_binary, zero_division=0
    )

    if abs(precision - recall) < 0.01:
        print(
            f"Threshold: {threshold:.2f}, "
            f"Precision: {precision:.3f}, "
            f"Recall: {recall:.3f}"
        )


f1_scores = []

for threshold in thresholds:
    y_pred_binary = (y_pred >= threshold).astype(int)
    f1 = f1_score(y_val, y_pred_binary, zero_division=0)
    f1_scores.append(f1)

best_index = np.argmax(f1_scores)

print(f"Best threshold: {thresholds[best_index]:.2f}")
print(f"Best F1 score: {f1_scores[best_index]:.3f}")


kf = KFold(n_splits=5, shuffle=True, random_state=1)
scores = []

for train_idx, val_idx in kf.split(df_full_train):
    df_train_fold = df_full_train.iloc[train_idx]
    df_val_fold = df_full_train.iloc[val_idx]

    y_train_fold = df_train_fold["converted"].values
    y_val_fold = df_val_fold["converted"].values

    train_dicts = df_train_fold.drop(
        columns=["converted"]
    ).to_dict(orient="records")

    val_dicts = df_val_fold.drop(
        columns=["converted"]
    ).to_dict(orient="records")

    dv_fold = DictVectorizer(sparse=True)

    X_train_fold = dv_fold.fit_transform(train_dicts).astype(np.float64)
    X_val_fold = dv_fold.transform(val_dicts).astype(np.float64)

    X_train_fold.indices = X_train_fold.indices.astype(np.int32)
    X_train_fold.indptr = X_train_fold.indptr.astype(np.int32)
    X_val_fold.indices = X_val_fold.indices.astype(np.int32)
    X_val_fold.indptr = X_val_fold.indptr.astype(np.int32)

    model_fold = LogisticRegression(
        solver="liblinear",
        C=1.0,
        max_iter=1000
    )

    model_fold.fit(X_train_fold, y_train_fold)
    y_pred_fold = model_fold.predict_proba(X_val_fold)[:, 1]

    auc_fold = roc_auc_score(y_val_fold, y_pred_fold)
    scores.append(auc_fold)

print("AUC scores:", [round(score, 3) for score in scores])
print(f"Standard deviation: {np.std(scores):.3f}")


C_values = [0.000001, 0.001, 1]

for C in C_values:
    scores = []

    for train_idx, val_idx in kf.split(df_full_train):
        df_train_fold = df_full_train.iloc[train_idx]
        df_val_fold = df_full_train.iloc[val_idx]

        y_train_fold = df_train_fold["converted"].values
        y_val_fold = df_val_fold["converted"].values

        train_dicts = df_train_fold.drop(
            columns=["converted"]
        ).to_dict(orient="records")

        val_dicts = df_val_fold.drop(
            columns=["converted"]
        ).to_dict(orient="records")

        dv_fold = DictVectorizer(sparse=True)

        X_train_fold = dv_fold.fit_transform(train_dicts).astype(np.float64)
        X_val_fold = dv_fold.transform(val_dicts).astype(np.float64)

        X_train_fold.indices = X_train_fold.indices.astype(np.int32)
        X_train_fold.indptr = X_train_fold.indptr.astype(np.int32)
        X_val_fold.indices = X_val_fold.indices.astype(np.int32)
        X_val_fold.indptr = X_val_fold.indptr.astype(np.int32)

        model_fold = LogisticRegression(
            solver="liblinear",
            C=C,
            max_iter=1000
        )

        model_fold.fit(X_train_fold, y_train_fold)
        y_pred_fold = model_fold.predict_proba(X_val_fold)[:, 1]

        auc_fold = roc_auc_score(y_val_fold, y_pred_fold)
        scores.append(auc_fold)

    print(
        f"C={C}: Mean AUC={np.mean(scores):.3f}, "
        f"Std={np.std(scores):.3f}"
    )
